# ── Database (Neon Postgres) ──────────────────────────────────────────────
# Create a free project at https://neon.tech, then copy the pooled
# connection string it gives you (it will look like the example below).
# Neon's pooled connection is what your app should use at runtime.
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"

# Neon also gives you a *direct* (non-pooled) connection string — use that
# one for DIRECT_URL. Prisma's CLI (migrate, db push, prisma.config.ts) uses
# this one directly, since migrations can't run through the pooler.
DIRECT_URL="postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require"

# ── Auth (better-auth) ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET="replace-with-a-random-64-char-hex-string"
# The public URL of your deployed app (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Optional integrations (leave blank to disable the related feature) ────
# AI insights / chat (either works — code checks OPENAI first)
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# File uploads (Cloudinary) — required for the Files module
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Maps / geolocation (field sales module — MapLibre, token-free)
# Live Map uses MapLibre GL JS with free Carto tiles (no token required).
# Field tracking streams via navigator.geolocation.watchPosition → UserLiveLocation.
# Legacy NEXT_PUBLIC_MAPBOX_TOKEN is ignored if present; remove it if you wish.

# Background jobs (BullMQ + Redis)
# Required for: email queue, webhook delivery, AI report generation, file processing
# Local dev: docker run -d -p 6379:6379 redis:alpine
# Production: Use managed Redis (AWS ElastiCache, Redis Cloud, Upstash, etc.)
REDIS_URL="redis://localhost:6379"
QUEUE_PREFIX="kawman"
# Auto-start workers in development (set to "false" to disable)
AUTO_START_WORKERS="true"

# Transactional email (SMTP via Zoho Mail) — password reset + user invite emails.
# Use an app-specific password if 2FA is enabled on the mailbox.
# SMTP_HOST must be the same mailbox as SMTP_USER.
# Use smtp.zoho.com instead of smtp.zoho.in if your Zoho account is on the
# US data center.
SMTP_HOST="smtp.zoho.in"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# One-time bootstrap for /superadmin — generate a 64-char hex token (openssl rand -hex 32).
# Required by POST /superadmin until the first Organization exists; unused afterwards.
SUPERADMIN_SETUP_TOKEN="replace-with-a-64-char-hex-token-from-openssl-rand-hex-32"

# ── Zoho Sign-In (optional SSO for existing @kawmanexact.com users) ──────────
# Create a *Server-based* application in the Zoho API Console
# (api-console.zoho.in for IN DC, or api-console.zoho.com for US DC).
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/zoho
# ZOHO_ACCOUNTS_URL must match the data center of your Zoho client.
# Only users whose Zoho email ends with @kawmanexact.com
# (see ALLOWED_EMAIL_DOMAIN below) can sign in; existing users only — no
# new accounts are created (disableSignUp: true).
# Leave ZOHO_CLIENT_ID blank to disable the Zoho button entirely.
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_ACCOUNTS_URL="https://accounts.zoho.in"
ALLOWED_EMAIL_DOMAIN="kawmanexact.com"
NEXT_PUBLIC_ZOHO_LOGIN_ENABLED="false"
